# Example systemd unit for the deployed daemon.
#
# Install on the remote (once):
#   sudo cp my-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable my-daemon
#
# `deploy/config.ts` stops and starts this service around each deploy, so the remote user needs
# passwordless `sudo systemctl`.

[Unit]
Description=My daemon
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/my-daemon/daemon
ExecStart=/usr/bin/node --enable-source-maps src/main.js
Restart=on-failure
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
