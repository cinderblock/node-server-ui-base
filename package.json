{
  "name": "node-server-ui-base",
  "version": "1.0.0-alpha",
  "description": "Coupled daemon and UI with bundled deploy scripts",
  "repository": "github:cinderblock/node-server-ui-base",
  "author": "Cameron Tacklind <cameron@tacklind.com> (https://cameron.tacklind.com)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "daemon",
    "ui",
    "deploy"
  ],
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "bun daemon/scripts/ensure-config.ts",
    "dev": "bun run --filter daemon --filter ui dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "bun run typecheck && prettier --check .",
    "format": "prettier --write .",
    "remote": "bun run --cwd deploy remote"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3"
  }
}
