{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Remote daemon kill",
      "type": "shell",
      "command": "bun",
      "args": ["run", "remote", "--", "run", "kill"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "WebUI Dev Server",
      "type": "shell",
      "command": "bun",
      "args": ["run", "--cwd", "ui", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "Server Deploy",
      "type": "shell",
      "command": "bun",
      "args": ["run", "--cwd", "deploy", "dev:daemon"],
      "presentation": {
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Development",
      "dependsOn": ["WebUI Dev Server", "Server Deploy"],
      "group": "build"
    }
  ]
}
