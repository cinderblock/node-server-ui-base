{
  "name": "daemon",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "build/daemon/src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start:node": "node --enable-source-maps build/daemon/src/main.js",
    "shutdown": "sudo shutdown -h now",
    "reboot": "sudo reboot",
    "kill": "kill $(cat /tmp/daemon.pid 2> /dev/null) 2> /dev/null || :"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "server-starter": "^2.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "socket.io-client": "^4.8.1",
    "typescript": "~6.0.3"
  }
}
